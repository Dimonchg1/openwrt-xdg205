/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include "sparx5.dtsi"

/ {
	model = "Connect Tech Xtreme/10G XDG205";
	compatible = "connecttech,xdg205", "microchip,sparx5";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	/* Placeholder; SparX-5 DDR base is 0x0 (see PCB125). Vendor
	 * bootloader fixup expected to override the size. */
	memory@0 {
		device_type = "memory";
		reg = <0x0 0x0 0x0 0x40000000>;
	};

	/*
	 * XDG205 10G ports 0-6 are direct KR backplane lanes (no SFP cages,
	 * no i2c dependency). Mainline sparx5 driver has no 10GBase-KR mode,
	 * so the ports run as 10GBase-R with fixed-link.
	 *
	 * ASSUMPTION (no schematic, no console access):
	 * label port N = switch port 56+N = serdes 25+N (VSC7558 HS lanes).
	 * On PCB135 serdes = switch port - 31. Verify on hardware and adjust.
	 */
};

&uart0 {
	status = "okay";
};

&uart1 {
	status = "okay";
};

&i2c0 {
	status = "okay";
};

&i2c1 {
	status = "okay";
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;
		#address-cells = <1>;
		#size-cells = <1>;

		/* Layout mirrors U-Boot MTDPARTS_DEFAULT (BSP nor_parts):
		 * 1m(UBoot),256k(Env),256k(Env.bk),46m(linux),46m(linux.bk),32m(rootfs_data)
		 */
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "UBoot";
				reg = <0x0 0x100000>;
				read-only;
			};

			partition@100000 {
				label = "Env";
				reg = <0x100000 0x40000>;
				read-only;
			};

			partition@140000 {
				label = "Env.bk";
				reg = <0x140000 0x40000>;
				read-only;
			};

			partition@180000 {
				label = "linux";
				reg = <0x180000 0x2e00000>;
			};

			partition@2f80000 {
				label = "linux.bk";
				reg = <0x2f80000 0x2e00000>;
			};

			partition@5d80000 {
				label = "rootfs_data";
				reg = <0x5d80000 0x2000000>;
			};
		};
	};
};

&sdhci0 {
	status = "okay";
	non-removable;
};

&serdes {
	status = "okay";
};

&switch {
	status = "okay";

	ethernet-ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port56: port@56 {
			reg = <56>;
			microchip,bandwidth = <10000>;
			phys = <&serdes 25>;
			phy-mode = "10gbase-r";
			openwrt,netdev-name = "lan1";
			fixed-link {
				speed = <10000>;
				full-duplex;
				pause;
			};
		};

		port57: port@57 {
			reg = <57>;
			microchip,bandwidth = <10000>;
			phys = <&serdes 26>;
			phy-mode = "10gbase-r";
			openwrt,netdev-name = "lan2";
			fixed-link {
				speed = <10000>;
				full-duplex;
				pause;
			};
		};

		port58: port@58 {
			reg = <58>;
			microchip,bandwidth = <10000>;
			phys = <&serdes 27>;
			phy-mode = "10gbase-r";
			openwrt,netdev-name = "lan3";
			fixed-link {
				speed = <10000>;
				full-duplex;
				pause;
			};
		};

		port59: port@59 {
			reg = <59>;
			microchip,bandwidth = <10000>;
			phys = <&serdes 28>;
			phy-mode = "10gbase-r";
			openwrt,netdev-name = "lan4";
			fixed-link {
				speed = <10000>;
				full-duplex;
				pause;
			};
		};

		port60: port@60 {
			reg = <60>;
			microchip,bandwidth = <10000>;
			phys = <&serdes 29>;
			phy-mode = "10gbase-r";
			openwrt,netdev-name = "lan5";
			fixed-link {
				speed = <10000>;
				full-duplex;
				pause;
			};
		};

		port61: port@61 {
			reg = <61>;
			microchip,bandwidth = <10000>;
			phys = <&serdes 30>;
			phy-mode = "10gbase-r";
			openwrt,netdev-name = "lan6";
			fixed-link {
				speed = <10000>;
				full-duplex;
				pause;
			};
		};

		port62: port@62 {
			reg = <62>;
			microchip,bandwidth = <10000>;
			phys = <&serdes 31>;
			phy-mode = "10gbase-r";
			openwrt,netdev-name = "lan7";
			fixed-link {
				speed = <10000>;
				full-duplex;
				pause;
			};
		};

		/* Management port, serdes 0 SGMII as on PCB134/PCB135. */
		port64: port@64 {
			reg = <64>;
			microchip,bandwidth = <1000>;
			phys = <&serdes 0>;
			phy-mode = "sgmii";
			managed = "in-band-status";
			openwrt,netdev-name = "wan";
		};
	};
};
