
. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

xdg205_setup_interfaces()
{
	local board="$1"

	case "$board" in
	connecttech,xdg205)
		ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4 lan5 lan6 lan7" "wan"
		;;
	*)
		echo "Unsupported hardware. Network interfaces not initialized"
		;;
	esac
}

board_config_update
board=$(board_name)
xdg205_setup_interfaces $board
board_config_flush

exit 0
